{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feriados.schema.json",
  "title": "Feriados de Moçambique",
  "type": "object",
  "required": ["meta", "feriados"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["nome", "versao", "idioma", "pais", "total", "licenca"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string" },
        "versao": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "idioma": { "type": "string" },
        "pais": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "total": { "type": "integer", "minimum": 1 },
        "licenca": { "type": "string" },
        "autor": { "type": "string" },
        "fontes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "feriados": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feriado" }
    }
  },
  "$defs": {
    "imagem": {
      "type": "object",
      "required": ["url", "alt"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "credito": { "type": "string" },
        "tipo": { "enum": ["foto", "ilustracao", "cartaz", "bandeira"] }
      }
    },
    "personalidade": {
      "type": "object",
      "required": ["nome", "papel"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "papel": { "type": "string", "minLength": 1 },
        "nascimento": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "morte": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "feriado": {
      "type": "object",
      "required": ["id", "nome", "tipo", "mes", "dia", "movel"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "nome": { "type": "string", "minLength": 1 },
        "tipo": { "enum": ["nacional", "provincial", "municipal", "religioso", "tolerancia_ponto"] },
        "mes": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
        "dia": { "type": ["integer", "null"], "minimum": 1, "maximum": 31 },
        "movel": { "type": "boolean" },
        "regra": { "type": "string" },
        "calculo": { "enum": ["sexta-feira-santa"] },
        "datas": {
          "type": "object",
          "propertyNames": { "pattern": "^\\d{4}$" },
          "additionalProperties": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "descricaoCurta": { "type": "string" },
        "descricao": { "type": "string" },
        "local": { "type": "string" },
        "provincia": { "type": "string" },
        "distrito": { "type": "string" },
        "municipio": { "type": "string" },
        "intervenientes": { "type": "array", "items": { "type": "string" } },
        "personalidades": { "type": "array", "items": { "$ref": "#/$defs/personalidade" } },
        "anoEvento": { "type": "integer" },
        "anoInstituicao": { "type": "integer" },
        "instrumentoLegal": { "type": "string" },
        "observancia": { "type": "string" },
        "imagens": { "type": "array", "items": { "$ref": "#/$defs/imagem" } }
      },
      "if": {
        "properties": { "movel": { "const": true } }
      },
      "then": {
        "required": ["regra"],
        "properties": {
          "mes": { "type": "null" },
          "dia": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "mes": { "type": "integer" },
          "dia": { "type": "integer" }
        }
      }
    }
  }
}
